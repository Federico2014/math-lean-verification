{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit administrator approval for one protected verification run",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision": {
      "const": "accepted"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])",
      "maxLength": 80
    },
    "administrator": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$(?![\\s\\S])"
    },
    "accepted_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "run_id": {
      "type": "integer",
      "minimum": 1
    },
    "run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_id": {
      "type": "integer",
      "minimum": 1
    },
    "verifier_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
    },
    "statement_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    }
  },
  "required": [
    "schema_version",
    "decision",
    "candidate_id",
    "administrator",
    "accepted_on",
    "reason",
    "run_id",
    "run_attempt",
    "artifact_id",
    "verifier_sha",
    "source_commit",
    "statement_digest",
    "archive_sha256"
  ],
  "additionalProperties": false
}
