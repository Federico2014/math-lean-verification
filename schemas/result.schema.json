{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification result summary",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "verification_status": {
      "enum": [
        "verified",
        "review_pending",
        "failed",
        "not_run",
        "unsupported",
        "infrastructure_error"
      ]
    },
    "machine_status": {
      "enum": [
        "not_run",
        "failed",
        "passed"
      ]
    },
    "review_status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "invalidated"
      ]
    },
    "formal_status": {
      "const": "pending"
    },
    "bindings": {
      "type": "object",
      "properties": {
        "pr_head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
        },
        "upstream_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
        },
        "workspace_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_attempt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pr_head",
        "base_sha",
        "upstream_commit",
        "workspace_digest",
        "environment_digest",
        "policy_digest",
        "run_id",
        "run_attempt"
      ],
      "additionalProperties": false
    },
    "official_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "candidate_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "completed_stages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "failed_stage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "input_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "image_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "submission_id",
    "verification_status",
    "machine_status",
    "review_status",
    "formal_status",
    "bindings",
    "official_targets",
    "candidate_targets",
    "completed_stages",
    "failed_stage",
    "input_digest",
    "image_id",
    "error"
  ],
  "additionalProperties": false
}
