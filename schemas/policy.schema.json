{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Federico2014/math-lean-verification/schemas/policy.schema.json",
  "title": "policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "standard_axioms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "approved_reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 39,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "minimum_independent_reviewers": {
      "const": 2
    },
    "backend": {
      "enum": [
        "unconfigured",
        "comparator-export-v1"
      ]
    },
    "toolchains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "formal_acceptance_enabled": {
      "const": false
    },
    "administrator_exceptions": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "problem_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
          },
          "statement_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^v[1-9][0-9]*$(?![\\s\\S])"
          },
          "statement_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "administrator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 39,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$(?![\\s\\S])"
          },
          "evidence_url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$(?![\\s\\S])",
            "minLength": 1,
            "maxLength": 2048
          },
          "reason": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4000
          }
        },
        "required": [
          "problem_id",
          "statement_version",
          "statement_digest",
          "administrator",
          "evidence_url",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "standard_axioms",
    "approved_reviewers",
    "minimum_independent_reviewers",
    "backend",
    "toolchains",
    "formal_acceptance_enabled"
  ],
  "additionalProperties": false
}
