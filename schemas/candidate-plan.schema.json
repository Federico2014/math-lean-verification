{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate-plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "candidate_repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$(?![\\s\\S])"
    },
    "candidate_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "machine_status": {
      "const": "not_run"
    },
    "formal_status": {
      "const": "pending"
    },
    "plan_kind": {
      "const": "candidate_intake"
    },
    "candidate_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    }
  },
  "required": [
    "schema_version",
    "submission_id",
    "candidate_repository",
    "candidate_commit",
    "blockers",
    "machine_status",
    "formal_status",
    "plan_kind",
    "candidate_digest"
  ]
}
