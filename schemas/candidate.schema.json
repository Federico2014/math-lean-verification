{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "problem_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "statement_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^v[1-9][0-9]*$(?![\\s\\S])"
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source_url",
        "scope"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$(?![\\s\\S])"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$(?![\\s\\S])"
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
        },
        "project_root": {
          "anyOf": [
            {
              "const": "."
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$(?![\\s\\S])"
            }
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_*][A-Za-z0-9_./*-]*$(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"
          },
          "declaration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"
          },
          "official_theorem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"
          }
        },
        "required": [
          "module",
          "declaration"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "attribution": {
      "type": "object",
      "properties": {
        "proof_authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "formalization_authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "proof_route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "ai_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "known_assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "prior_results": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "proof_authors",
        "formalization_authors",
        "proof_route",
        "ai_role",
        "known_assumptions"
      ],
      "additionalProperties": false
    },
    "paper_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "^https://[^\\s]+$(?![\\s\\S])"
      },
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true
    },
    "public_source_authorized": {
      "type": "boolean"
    },
    "bridge": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_/]*\\.lean$(?![\\s\\S])",
      "maxLength": 256
    }
  },
  "required": [
    "schema_version",
    "title",
    "source",
    "targets",
    "attribution",
    "public_source_authorized"
  ],
  "anyOf": [
    {
      "required": [
        "problem_id"
      ]
    },
    {
      "required": [
        "problem"
      ]
    }
  ]
}
