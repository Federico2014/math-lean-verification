{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intake-mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_digest",
    "problem_id",
    "statement_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "statement_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^v[1-9][0-9]*$(?![\\s\\S])"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"
          },
          "declaration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"
          },
          "official_theorem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"
          }
        },
        "required": [
          "module",
          "declaration",
          "official_theorem"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "source_transforms": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*\\.lean$(?![\\s\\S])"
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*\\.lean$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "replacements": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "old": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "new": {
                  "type": "string",
                  "maxLength": 8192
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              },
              "required": [
                "old",
                "new",
                "count"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "destination",
          "sha256",
          "replacements"
        ],
        "additionalProperties": false
      }
    },
    "reviewed_metadata_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    }
  }
}
