{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Federico2014/math-lean-verification/schemas/plan.schema.json",
  "title": "plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "input_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 2000,
      "uniqueItems": true
    },
    "candidate_repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$(?![\\s\\S])"
    },
    "candidate_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
    },
    "required_theorems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$(?![\\s\\S])"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "machine_status": {
      "const": "not_run"
    },
    "formal_status": {
      "const": "pending"
    },
    "backend": {
      "enum": [
        "unconfigured",
        "comparator-export-v1"
      ]
    }
  },
  "required": [
    "schema_version",
    "submission_id",
    "input_digest",
    "inputs",
    "candidate_repository",
    "candidate_commit",
    "required_theorems",
    "blockers",
    "machine_status",
    "formal_status",
    "backend"
  ],
  "additionalProperties": false
}
